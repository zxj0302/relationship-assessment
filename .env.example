# Deployment & App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret for local testing via `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend API Key for Transactional Emails (Get from https://resend.com/api-keys)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="assessments@yourdomain.com"

# Secret key used to sign and verify tamper-proof assessment result tokens
TOKEN_SECRET="super-secret-jwt-signing-key-min-32-chars-long-12345678"

# Optional: AI Provider (OpenAI / Anthropic) for dynamic live report synthesis
OPENAI_API_KEY="sk-..."
