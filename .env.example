# Deployment & App URL (Must match your live production domain)
NEXT_PUBLIC_APP_URL="https://relationship-assessment-apv.pages.dev"
NEXT_PUBLIC_SUPPORT_EMAIL="zhuxiangjv+support@gmail.com"
NEXT_PUBLIC_PRIVACY_EMAIL="zhuxiangjv+support@gmail.com"

# Stripe Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret from Stripe Dashboard (`checkout.session.completed` & `checkout.session.async_payment_succeeded`)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend API Key for Transactional Emails (Get from https://resend.com/api-keys)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="assessments@yourdomain.com"

# Secret key used to sign and verify tamper-proof assessment result tokens (MUST be >= 32 random chars in production)
TOKEN_SECRET="replace-with-a-random-32-plus-char-production-secret"
